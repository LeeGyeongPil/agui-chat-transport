# No secrets are needed. Everything below is optional.

# Point the Node quickstart at a real AG-UI server instead of the built-in mock:
#   AGUI_URL=http://localhost:8000/agent npm run example
AGUI_URL=

# Output language of the Node quickstart: en | ko (the --lang flag wins over this)
AGUI_EXAMPLE_LANG=

# Point the web example at a real AG-UI server (read by Vite, so it needs the VITE_ prefix)
VITE_AGUI_URL=
