{
  "name": "agui-chat-transport",
  "version": "0.1.3",
  "description": "Use any AG-UI agent server from AI SDK useChat: a ChatTransport that converts AG-UI events to UIMessage chunks and back, and reports what it cannot map.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeeGyeongPil/agui-chat-transport.git"
  },
  "homepage": "https://github.com/LeeGyeongPil/agui-chat-transport#readme",
  "bugs": {
    "url": "https://github.com/LeeGyeongPil/agui-chat-transport/issues"
  },
  "keywords": [
    "ai-sdk",
    "useChat",
    "ag-ui",
    "agent",
    "transport",
    "langgraph",
    "mastra"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/mapping.md",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dev": "tsc -p tsconfig.dev.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run build:dev && node --test --test-concurrency=1 --test-timeout=120000 \".build/test/*.test.js\"",
    "ci": "npm run typecheck && npm test",
    "example": "npm run -s build:dev && node .build/examples/quickstart.js",
    "example:web": "npm --prefix examples/react-chat ci && npm --prefix examples/react-chat run dev",
    "example:web:build": "npm --prefix examples/react-chat ci && npm --prefix examples/react-chat run build",
    "release:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "fast-json-patch": "3.1.2"
  },
  "peerDependencies": {
    "@ag-ui/client": "^1.0.5",
    "@ag-ui/core": "^1.0.5",
    "@ag-ui/encoder": "^1.0.5",
    "ai": "^7.0.181"
  },
  "peerDependenciesMeta": {
    "@ag-ui/encoder": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ag-ui/client": "^1.0.5",
    "@ag-ui/core": "^1.0.5",
    "@ag-ui/encoder": "^1.0.5",
    "@types/node": "^22.0.0",
    "ai": "^7.0.181",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
